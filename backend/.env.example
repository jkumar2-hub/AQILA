# AQILA — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — Copy this file to .env and fill in real values.
# The real .env is gitignored and must NEVER be committed.
#
# Owner: M4 — Backend / Platform / Integration
# Reference: v4.1 §8 Docker + Ollama Networking
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama ───────────────────────────────────────────────────────────────────
# Dev mode (local process):    http://localhost:11434
# Container mode (Docker):     http://ollama:11434   ← Docker service name, NOT localhost
# NEVER hardcode localhost in application code; always read from this env var.
OLLAMA_BASE_URL=http://localhost:11434

# Primary LLM model (P0 required — must be pre-pulled before hackathon)
# ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# Vision model (P1 optional — only if hardware allows; do not load simultaneously with 3b without testing)
# ollama pull llama3.2-vision:11b
OLLAMA_VISION_MODEL=llama3.2-vision:11b

# Max loaded models (set to 1 if OOM occurs with multiple models)
# OLLAMA_MAX_LOADED_MODELS=1

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Persistent ChromaDB storage directory (gitignored via data/)
CHROMA_PERSIST_PATH=./data/chroma

# ── SQLite ───────────────────────────────────────────────────────────────────
# SQLite database file path (gitignored via data/)
DATABASE_URL=sqlite+aiosqlite:///./data/aqila.db

# ── File storage ─────────────────────────────────────────────────────────────
# Upload directory for ingested source files (gitignored via data/)
UPLOAD_DIR=./data/uploads

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
